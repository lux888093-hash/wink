.dock-shell {
  position: fixed;
  left: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
  z-index: 999;
  display: flex;
  gap: 2rpx;
  padding: 10rpx 12rpx 12rpx;
  border-radius: 20rpx;
  background:
    linear-gradient(180deg, rgba(32, 25, 23, 0.98), rgba(18, 14, 13, 0.98));
  border: 1rpx solid rgba(220, 185, 133, 0.12);
  box-shadow: 0 8rpx 20rpx rgba(18, 12, 11, 0.12);
}

.dock-item {
  position: relative;
  flex: 1;
  min-width: 0;
  min-height: 78rpx;
  padding: 8rpx 8rpx 0;
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: rgba(255, 246, 235, 0.5);
  transition: transform 0.18s ease, opacity 0.18s ease, color 0.18s ease;
}

.dock-item:active {
  transform: scale(0.97);
  opacity: 0.86;
}

.dock-press {
  transform: scale(0.97);
  opacity: 0.86;
}

.dock-label {
  color: inherit;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
  letter-spacing: 0;
  white-space: nowrap;
}

.dock-indicator {
  width: 28rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: transparent;
  transition: background-color 0.18s ease, width 0.18s ease;
}

.dock-badge {
  position: absolute;
  top: 8rpx;
  right: 10rpx;
  min-width: 28rpx;
  min-height: 28rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #dcc08a;
  color: #241b14;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}

.is-active {
  color: #f3e7d5;
}

.is-active .dock-label {
  font-weight: 600;
}

.is-active .dock-indicator {
  width: 40rpx;
  background: #dcc08a;
}
