.dock-shell {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 999;
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 26rpx;
  background: rgba(24, 18, 17, 0.92);
  border: 1rpx solid rgba(220, 185, 133, 0.16);
}

.dock-item {
  position: relative;
  flex: 1;
  min-width: 0;
  min-height: 72rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 246, 235, 0.56);
  transition: transform 0.18s ease, opacity 0.18s ease, color 0.18s ease, background-color 0.18s ease;
}

.dock-item:active {
  transform: scale(0.97);
  opacity: 0.86;
}

.dock-press {
  background: rgba(247, 236, 221, 0.05);
  transform: scale(0.97);
  opacity: 0.86;
}

.dock-label {
  color: inherit;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  letter-spacing: 0;
  white-space: nowrap;
}

.dock-badge {
  position: absolute;
  top: 8rpx;
  right: 10rpx;
  min-width: 28rpx;
  min-height: 28rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #dcc08a;
  color: #241b14;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}

.is-active {
  color: #dcc08a;
  background: rgba(247, 236, 221, 0.08);
}
