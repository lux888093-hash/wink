<view class="shell">
  <view wx:if="{{pageReady}}" class="page-scroll estate-page">
    <view class="estate-hero">
      <image class="estate-hero-image" src="{{heroImage}}" mode="aspectFill"></image>
      <view class="estate-hero-mask"></view>
      <view class="estate-hero-copy">
        <text class="estate-kicker">{{hero.eyebrow || '酒庄'}}</text>
        <text class="estate-title">{{winery.name}}</text>
        <text class="estate-tagline">{{winery.tagline}}</text>
      </view>
    </view>

    <view class="estate-facts">
      <view class="estate-fact" wx:for="{{estateFacts}}" wx:key="label">
        <text class="estate-fact-label">{{item.label}}</text>
        <text class="estate-fact-value">{{item.value}}</text>
      </view>
    </view>

    <view class="estate-statement">
      <view class="estate-statement-copy">
        <text class="estate-statement-kicker">{{statementKicker}}</text>
        <text class="estate-statement-title">{{statementTitle}}</text>
        <text wx:if="{{homeContent.statementBody}}" class="estate-statement-body">{{homeContent.statementBody}}</text>
      </view>
    </view>

    <view wx:if="{{winery.intro || winery.story}}" class="estate-archive">
      <text class="estate-archive-kicker">庄园简介</text>
      <text class="estate-archive-title">{{winery.name}}</text>
      <text wx:if="{{winery.intro}}" class="estate-archive-body">{{winery.intro}}</text>
      <text wx:if="{{winery.story}}" class="estate-archive-body">{{winery.story}}</text>
    </view>

    <view wx:if="{{estateChapters.length}}" class="estate-chapter-list">
      <text class="estate-chapter-list-kicker">静界篇章</text>
      <view class="estate-copy-chapter" wx:for="{{estateChapters}}" wx:key="title">
        <text class="estate-copy-chapter-eyebrow">{{item.eyebrow}}</text>
        <text class="estate-copy-chapter-title">{{item.title}}</text>
        <text wx:if="{{item.body}}" class="estate-copy-chapter-body">{{item.body}}</text>
      </view>
    </view>

    <view class="estate-chapters">
      <view class="estate-scenes-head">
        <text class="estate-scenes-kicker">庄园场景</text>
      </view>
      <view class="estate-chapter" wx:for="{{estateChapters}}" wx:key="eyebrow">
        <image class="estate-chapter-image" src="{{item.image}}" mode="aspectFill"></image>
        <view class="estate-chapter-mask"></view>
        <view class="estate-chapter-copy">
          <text class="estate-chapter-eyebrow">{{item.eyebrow}}</text>
          <text class="estate-chapter-title">{{item.title}}</text>
          <text wx:if="{{item.body}}" class="estate-chapter-body line-clamp-2">{{item.body}}</text>
        </view>
      </view>
    </view>

    <text class="estate-age-note">{{ageNote}}</text>

    <view class="tabbar-gap"></view>
    <boutique-tabbar active="home" cartCount="{{cartCount}}"></boutique-tabbar>
  </view>

  <view wx:elif="{{errorTitle}}" class="page-scroll empty-state">
    <text class="empty-title">{{errorTitle}}</text>
    <text class="empty-subtitle">{{errorMessage}}</text>
    <button class="ghost-button" bindtap="loadPage">重新加载</button>
  </view>
</view>
