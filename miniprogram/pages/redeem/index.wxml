<view class="shell">
  <view class="redeem-page">
    <image class="redeem-bg" src="/assets/images/winery-vineyard-moon.jpg" mode="aspectFill"></image>
    <view class="redeem-mask"></view>

    <view class="redeem-copy">
      <text class="eyebrow">专属入口</text>
      <text class="display-title redeem-title">输入提取码</text>
      <text class="muted-copy redeem-subtitle">请输入六位数字。</text>
    </view>

    <view class="redeem-card {{state === 'success' ? 'redeem-card-success' : ''}}">
      <text class="eyebrow">{{state === 'idle' || state === 'error' ? '六位数字' : state === 'success' ? '已解锁' : '正在验证'}}</text>
      <text class="section-title redeem-card-title">{{title}}</text>
      <text class="muted-copy line-clamp-3">{{message}}</text>

      <view wx:if="{{state === 'idle' || state === 'error'}}" class="code-input-area">
        <view class="digit-row" bindtap="focusCodeInput">
          <view
            wx:for="{{codeBoxes}}"
            wx:key="index"
            class="digit-box {{item.digit ? 'digit-filled' : ''}} {{item.isActive ? 'digit-active' : ''}}"
          >
            <text>{{item.digit}}</text>
          </view>
        </view>
        <input
          class="code-hidden-input"
          type="number"
          maxlength="6"
          value="{{fullCode}}"
          focus="{{inputFocused}}"
          confirm-type="done"
          cursor-spacing="90"
          adjust-position="{{true}}"
          bindinput="onCodeInput"
          bindfocus="onCodeFocus"
          bindblur="onCodeBlur"
        />
      </view>

      <view wx:if="{{state === 'loading'}}" class="loading-row">
        <view class="loading-dot"></view>
        <view class="loading-dot"></view>
        <view class="loading-dot"></view>
      </view>

      <view wx:if="{{state === 'success'}}" class="success-stage">
        <view class="success-mark">
          <view class="success-mark-core">
            <text class="success-mark-icon">✓</text>
          </view>
        </view>
        <view class="success-progress">
          <view class="success-progress-fill"></view>
        </view>
        <text class="success-note">正在进入专属页</text>
      </view>

      <button wx:if="{{state === 'error'}}" class="ghost-button full-width" bindtap="clearInput">重新输入</button>
    </view>
  </view>
</view>
