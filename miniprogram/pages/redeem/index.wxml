<view class="shell">
  <view class="redeem-page">
    <image class="redeem-bg" src="/assets/images/vinyl-ode-bottle-vineyard.jpg" mode="aspectFill"></image>
    <view class="redeem-mask"></view>

    <view class="redeem-copy">
      <text class="eyebrow">VILLAGE ANCIENT VINE</text>
      <text class="display-title redeem-title">567 古藤西拉</text>
      <text class="muted-copy redeem-subtitle">输入酒瓶标签上的六位提取码，开启这瓶酒的专属酒庄体验。</text>
    </view>

    <view class="redeem-estate-panel">
      <image class="redeem-estate-image" src="/assets/images/village-ancient-vine-sign.jpg" mode="aspectFill"></image>
      <view class="redeem-estate-copy">
        <text class="redeem-estate-kicker">A Quiet World</text>
        <text class="redeem-estate-title">南澳古藤 · 黑胶颂</text>
        <view class="redeem-estate-meta">
          <text>2022</text>
          <text>Shiraz</text>
          <text>14.3%vol</text>
        </view>
      </view>
    </view>

    <view class="redeem-card {{state === 'success' ? 'redeem-card-success' : ''}}">
      <text class="eyebrow">{{state === 'idle' || state === 'error' ? '提取码验证' : state === 'success' ? 'ACCESS GRANTED' : title}}</text>
      <text class="section-title redeem-card-title">{{title}}</text>
      <text class="muted-copy line-clamp-3">{{message}}</text>

      <view wx:if="{{state === 'idle' || state === 'error'}}" class="code-input-area">
        <view class="digit-row" bindtap="focusCodeInput">
          <view
            wx:for="{{codeBoxes}}"
            wx:key="index"
            class="digit-box {{item.digit ? 'digit-filled' : ''}} {{item.isActive ? 'digit-active' : ''}}"
          >
            <text>{{item.digit}}</text>
          </view>
        </view>
        <input
          class="code-hidden-input"
          type="number"
          maxlength="6"
          value="{{fullCode}}"
          focus="{{inputFocused}}"
          confirm-type="done"
          cursor-spacing="90"
          adjust-position="{{true}}"
          bindinput="onCodeInput"
          bindfocus="onCodeFocus"
          bindblur="onCodeBlur"
        />
      </view>

      <view wx:if="{{state === 'loading'}}" class="loading-row">
        <view class="loading-dot"></view>
        <view class="loading-dot"></view>
        <view class="loading-dot"></view>
      </view>

      <view wx:if="{{state === 'success'}}" class="success-stage">
        <view class="success-mark">
          <view class="success-mark-core">
            <text class="success-mark-icon">✓</text>
          </view>
        </view>
        <view class="success-progress">
          <view class="success-progress-fill"></view>
        </view>
        <text class="success-note">正在打开酒庄私享内容</text>
      </view>

      <button wx:if="{{state === 'error'}}" class="ghost-button full-width" bindtap="clearInput">重新输入</button>
    </view>
  </view>
</view>
